    border-radius: 0.25em;
  }

  pre {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 0.5em;
    padding: 1em 1.25em;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  pre code {
    background: none;
    padding: 0;
    font-size: 0.85em;
    line-height: 1.6;
  }

  .chapter-nav {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .chapter-nav a {
    text-decoration: none;
    color: var(--text-muted);
  }

  .chapter-nav a:hover {
    color: var(--coral);
  }
</style>
